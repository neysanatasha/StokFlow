<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    @if (context.User.Identity?.IsAuthenticated == true)
                    {
                        <div class="alert alert-danger m-4">Anda tidak punya akses ke halaman ini.</div>
                    }
                    else
                    {
                        <RedirectToLogin />
                    }
                </NotAuthorized>
                <Authorizing>
                    <p class="p-4">Memeriksa login...</p>
                </Authorizing>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <PageTitle>Tidak ditemukan</PageTitle>
            <LayoutView Layout="@typeof(MainLayout)">
                <p role="alert" class="p-4">Halaman tidak ditemukan.</p>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>