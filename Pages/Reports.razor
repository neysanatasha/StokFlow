@page "/laporan"
@attribute [Authorize(Roles = "Admin,Manajer")]
@inject ReportService ReportSvc
@inject IJSRuntime JS

<PageTitle>Reporting</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Laporan</h3>
    <button class="btn btn-outline-secondary no-print" @onclick="Print">🖨️ Cetak</button>
</div>

<!-- ====== FILTER TANGGAL ====== -->
<div class="card mb-4 no-print">
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label">Dari tanggal</label>
                <input type="date" class="form-control" @bind="fromDate" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Sampai tanggal</label>
                <input type="date" class="form-control" @bind="toDate" />
            </div>
            <div class="col-md-2">
                <button class="btn btn-primary w-100" @onclick="Load">Tampilkan</button>
            </div>
            <div class="col-md-4">
                <button class="btn btn-sm btn-outline-primary me-1" @onclick="SetToday">Hari ini</button>
                <button class="btn btn-sm btn-outline-primary me-1" @onclick="SetThisMonth">Bulan ini</button>
                <button class="btn btn-sm btn-outline-primary" @onclick="SetLast30Days">30 hari terakhir</button>
            </div>
        </div>
    </div>
</div>

@if (errorMessage != "")
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (report != null)
{
    <p class="text-muted">
        Periode: <strong>@report.From.ToString("dd/MM/yyyy")</strong> s/d <strong>@report.To.ToString("dd/MM/yyyy")</strong>
    </p>

    <!-- ====== RINGKASAN ====== -->
    <div class="row g-3 mb-3">
        <div class="col-md-3">
            <div class="card border-success h-100"><div class="card-body">
                <div class="text-muted">Penjualan</div>
                <h4 class="mb-0 text-success">@Money(report.TotalSales)</h4>
                <small class="text-muted">@report.ShippedOrderCount SO dikirim</small>
            </div></div>
        </div>
        <div class="col-md-3">
            <div class="card border-success h-100"><div class="card-body">
                <div class="text-muted">Laba Kotor @(report.HasMissingCost ? "*" : "")</div>
                <h4 class="mb-0 text-success">@Money(report.GrossProfit)</h4>
                <small class="text-muted">Modal: @Money(report.TotalCogs)</small>
            </div></div>
        </div>
        <div class="col-md-3">
            <div class="card border-primary h-100"><div class="card-body">
                <div class="text-muted">Pembelian</div>
                <h4 class="mb-0">@Money(report.TotalPurchases)</h4>
                <small class="text-muted">@report.SupplierPurchases.Sum(s => s.DocumentCount) PO diterima</small>
            </div></div>
        </div>
        <div class="col-md-3">
            <div class="card border-danger h-100"><div class="card-body">
                <div class="text-muted">Kerugian Layu / Rusak</div>
                <h4 class="mb-0 text-danger">@Money(report.TotalWaste)</h4>
            </div></div>
        </div>
    </div>

    @if (report.HasMissingCost)
    {
        <div class="alert alert-warning small">
            * Sebagian produk belum pernah dibeli lewat PO, sehingga harga belinya belum diketahui.
            Laba produk tersebut ditandai "—" dan tidak dihitung dalam Laba Kotor.
        </div>
    }

    <!-- ====== 1. PENJUALAN PER PRODUK ====== -->
    <h5 class="mt-4">1. Penjualan per Produk</h5>
    @if (report.ProductSales.Count == 0)
    {
        <p class="text-muted">Belum ada penjualan pada periode ini.</p>
    }
    else
    {
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>Kode</th>
                    <th>Produk</th>
                    <th class="text-end">Terjual</th>
                    <th class="text-end">Penjualan</th>
                    <th class="text-end">Modal (HPP)</th>
                    <th class="text-end">Laba</th>
                    <th class="text-end">Margin</th>
                    <th style="width: 18%">Porsi Penjualan</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in report.ProductSales)
                {
                    var share = Share(r.Revenue);
                    <tr>
                        <td>@r.Sku</td>
                        <td>@r.Name</td>
                        <td class="text-end">@r.Quantity</td>
                        <td class="text-end">@Money(r.Revenue)</td>
                        <td class="text-end">@Money(r.Cogs)</td>
                        <td class="text-end">@Money(r.Profit)</td>
                        <td class="text-end">@Percent(r.MarginPercent)</td>
                        <td>
                            <div class="progress" style="height: 18px">
                                <div class="progress-bar bg-success" style="width: @(share)%">@(share)%</div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <!-- ====== 2. PELANGGAN & PEMASOK ====== -->
    <div class="row mt-4">
        <div class="col-md-6">
            <h5>2a. Penjualan per Pelanggan</h5>
            @if (report.CustomerSales.Count == 0)
            {
                <p class="text-muted">Belum ada data.</p>
            }
            else
            {
                <table class="table table-sm">
                    <thead><tr><th>Pelanggan</th><th class="text-end">Jumlah SO</th><th class="text-end">Total</th></tr></thead>
                    <tbody>
                        @foreach (var c in report.CustomerSales)
                        {
                            <tr><td>@c.Name</td><td class="text-end">@c.DocumentCount</td><td class="text-end">@Money(c.Total)</td></tr>
                        }
                    </tbody>
                </table>
            }
        </div>
        <div class="col-md-6">
            <h5>2b. Pembelian per Pemasok</h5>
            @if (report.SupplierPurchases.Count == 0)
            {
                <p class="text-muted">Belum ada data.</p>
            }
            else
            {
                <table class="table table-sm">
                    <thead><tr><th>Pemasok</th><th class="text-end">Jumlah PO</th><th class="text-end">Total</th></tr></thead>
                    <tbody>
                        @foreach (var s in report.SupplierPurchases)
                        {
                            <tr><td>@s.Name</td><td class="text-end">@s.DocumentCount</td><td class="text-end">@Money(s.Total)</td></tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

    <!-- ====== 3. KERUGIAN LAYU / RUSAK ====== -->
    <h5 class="mt-4">3. Kerugian Bunga Layu / Rusak</h5>
    @if (report.Waste.Count == 0)
    {
        <p class="text-muted">Tidak ada bunga yang terbuang pada periode ini. 🌸</p>
    }
    else
    {
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>Kode</th>
                    <th>Produk</th>
                    <th class="text-end">Jumlah</th>
                    <th class="text-end">Nilai per Unit</th>
                    <th class="text-end">Total Kerugian</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var w in report.Waste)
                {
                    <tr>
                        <td>@w.Sku</td>
                        <td>@w.Name</td>
                        <td class="text-end">@w.Quantity</td>
                        <td class="text-end">@Money(w.UnitValue) @(w.UsesSellingPrice ? "**" : "")</td>
                        <td class="text-end text-danger">@Money(w.Value)</td>
                    </tr>
                }
            </tbody>
        </table>
        @if (report.Waste.Any(w => w.UsesSellingPrice))
        {
            <p class="small text-muted">** Memakai harga jual karena harga belinya belum diketahui.</p>
        }
    }

    <!-- ====== 4. NILAI STOK SAAT INI ====== -->
    <h5 class="mt-4">4. Nilai Stok Saat Ini</h5>
    <table class="table table-sm">
        <thead>
            <tr>
                <th>Kode</th>
                <th>Produk</th>
                <th class="text-end">Stok</th>
                <th class="text-end">Harga Beli Rata-rata</th>
                <th class="text-end">Nilai (Harga Beli)</th>
                <th class="text-end">Nilai (Harga Jual)</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in report.StockValues)
            {
                <tr>
                    <td>@s.Sku</td>
                    <td>@s.Name</td>
                    <td class="text-end">@s.Stock</td>
                    <td class="text-end">@Money(s.AverageCost)</td>
                    <td class="text-end">@Money(s.ValueAtCost)</td>
                    <td class="text-end">@Money(s.ValueAtPrice)</td>
                </tr>
            }
            <tr class="fw-bold">
                <td colspan="4">Total</td>
                <td class="text-end">@Money(report.StockValues.Sum(s => s.ValueAtCost ?? 0))</td>
                <td class="text-end">@Money(report.StockValues.Sum(s => s.ValueAtPrice))</td>
            </tr>
        </tbody>
    </table>

    <p class="small text-muted mt-3">
        Cara hitung: Penjualan = SO yang sudah dikirim pada periode ini. Modal (HPP) = jumlah terjual × harga beli rata-rata
        dari semua PO yang sudah diterima. Laba kotor = Penjualan − Modal.
    </p>
}

@code {
    private DateTime fromDate = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime toDate = DateTime.Today;
    private ReportResult? report;
    private string errorMessage = "";

    protected override void OnInitialized()
    {
        Load();
    }

    private void Load()
    {
        errorMessage = "";
        try
        {
            report = ReportSvc.Build(fromDate, toDate);
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = ex.Message;
            report = null;
        }
    }

    // ---------- Tombol pintas periode ----------
    private void SetToday()
    {
        fromDate = DateTime.Today;
        toDate = DateTime.Today;
        Load();
    }

    private void SetThisMonth()
    {
        fromDate = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
        toDate = DateTime.Today;
        Load();
    }

    private void SetLast30Days()
    {
        fromDate = DateTime.Today.AddDays(-29);
        toDate = DateTime.Today;
        Load();
    }

    // ---------- Pembantu tampilan ----------
    // Porsi penjualan produk (0–100) dalam bilangan bulat
    private int Share(decimal revenue) =>
        report == null || report.TotalSales == 0 ? 0 : (int)Math.Round(revenue / report.TotalSales * 100);

    private static string Money(decimal? value) => value.HasValue ? "Rp " + value.Value.ToString("N0") : "—";
    private static string Percent(decimal? value) => value.HasValue ? value.Value.ToString("0.0") + "%" : "—";

    // Buka jendela cetak browser
    private async Task Print()
    {
        await JS.InvokeVoidAsync("print");
    }
}