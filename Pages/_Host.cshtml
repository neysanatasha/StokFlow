@page "/"
@using Microsoft.AspNetCore.Components.Web
@namespace StokFlow.Web.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="~/" />
    <link rel="stylesheet" href="css/bootstrap/bootstrap.min.css" />
    <link href="css/site.css" rel="stylesheet" />
    <link href="StokFlow.Web.styles.css" rel="stylesheet" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <component type="typeof(HeadOutlet)" render-mode="ServerPrerendered" />
</head>
<body>
    <component type="typeof(App)" render-mode="Server" />

    <div id="blazor-error-ui">
        <environment include="Staging,Production">
            Terjadi kesalahan. Muat ulang halaman.
        </environment>
        <environment include="Development">
            Terjadi kesalahan. Lihat detailnya di alat pengembang browser.
        </environment>
        <a href="" class="reload">Muat ulang</a>
        <a class="dismiss">🗙</a>
    </div>

    <script src="_framework/blazor.server.js"></script>
    <script src="js/theme.js"></script>
    <script src="js/download.js"></script>
</body>
</html>